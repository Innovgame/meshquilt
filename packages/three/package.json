{
    "name": "@meshquilt/three",
    "version": "0.1.0",
    "description": "THREE.Mesh adapter for MeshQuilt.",
    "type": "module",
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "keywords": [
        "3d",
        "mesh",
        "three",
        "compression"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "node ../../node_modules/typescript-compiler/bin/tsc -p tsconfig.json",
        "prepack": "pnpm --filter @meshquilt/core build && pnpm build"
    },
    "dependencies": {
        "@meshquilt/core": "workspace:*"
    },
    "peerDependencies": {
        "three": ">=0.160.0"
    },
    "devDependencies": {
        "@types/three": "^0.186.0",
        "three": "^0.186.1",
        "three-min": "npm:three@0.160.0"
    }
}
