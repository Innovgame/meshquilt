{
    "name": "@meshquilt/draco",
    "version": "0.1.0",
    "description": "Draco encoder and decoder adapters for MeshQuilt chunks.",
    "type": "module",
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./worker": "./worker/encode.worker.js"
    },
    "keywords": [
        "3d",
        "mesh",
        "draco",
        "compression"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "worker",
        "README.md"
    ],
    "scripts": {
        "build": "node ../../node_modules/typescript-compiler/bin/tsc -p tsconfig.json && node scripts/build-worker.mjs",
        "prepack": "pnpm --filter @meshquilt/core build && pnpm build",
        "test:browser": "node scripts/test-browser.mjs"
    },
    "dependencies": {
        "@meshquilt/core": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@types/draco3d": "^1.4.10",
        "draco3d": "1.5.7",
        "esbuild": "^0.28.2"
    }
}
