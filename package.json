{
    "name": "meshquilt-workspace",
    "private": true,
    "version": "0.1.0",
    "description": "Development workspace for the array-first MeshQuilt mesh codec and website.",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
    },
    "scripts": {
        "build": "pnpm -r --if-present build",
        "build:lib": "pnpm --filter meshquilt build",
        "test:packages": "pnpm build:lib && node scripts/verify-packages.mjs",
        "test:workers": "pnpm build:lib && pnpm --filter meshquilt test:browser",
        "bench": "vitest bench --run --maxWorkers=1 --reporter=verbose",
        "bench:browser": "pnpm build:lib && pnpm --filter @meshquilt/site exec playwright test --project library-performance",
        "release:check": "node scripts/release-check.mjs",
        "test:release": "node --test scripts/test/*.test.mjs",
        "site": "pnpm --filter @meshquilt/site dev",
        "site:build": "pnpm --filter @meshquilt/site build",
        "site:preview": "pnpm --filter @meshquilt/site preview",
        "site:test": "pnpm --filter @meshquilt/site test:e2e --project desktop --project mobile",
        "demo": "pnpm --filter @meshquilt/demo dev",
        "preview": "pnpm --filter @meshquilt/demo preview",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck",
        "check:fix": "pnpm format && pnpm lint:fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit && pnpm --filter @meshquilt/site typecheck"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "eslint": "^10.12.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-compiler": "npm:typescript@^7.0.2",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.4"
    },
    "license": "MIT",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
