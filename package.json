{
    "name": "meshquilt",
    "private": true,
    "version": "0.1.0",
    "description": "Chunked mesh codec for the browser. Split a THREE.Mesh, compress the pieces in parallel, and draw them back without seam cracks.",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "pnpm -r --if-present build",
        "demo": "pnpm --filter @meshquilt/demo dev",
        "preview": "pnpm --filter @meshquilt/demo preview",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck",
        "check:fix": "pnpm format && pnpm lint:fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.19.0",
        "eslint": "^10.2.0",
        "prettier": "^3.8.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.58.1",
        "vitest": "^3.2.4"
    },
    "license": "MIT",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
